{"spec": {"formatVersion": 3, "title": "Lane runner", "description": "Fixture", "capabilities": [], "stateSchema": {"lane": "number"}, "initialState": {"lane": 1}, "surfaces": [{"id": "main", "width": 300, "height": 300}], "hostControls": {"movement": ["main"]}, "ui": {"type": "column", "children": [{"type": "canvas", "text": "Road", "surfaces": ["main"]}, {"type": "text", "text": "Lane", "bind": "lane"}]}, "source": "const s=input.state,e=input.event;if(e.type==='control')s.lane=Math.max(0,Math.min(2,s.lane+(e.direction==='left'?-1:1)));return {state:s,surfaces:{main:{commands:[{type:'circle',x:50+s.lane*100,y:250,radius:20,color:'accent'}]}}};"}, "state": {"lane": 2}, "ui": {"type": "column", "children": [{"type": "canvas", "text": "Road", "surfaces": ["main"]}, {"type": "text", "text": "Lane", "bind": "lane"}]}}