              "text": "Miles",
              "bind": "miles"
            }
          ]
        },
        "source": "const s=input.state,e=input.event;if(e.type==='action'&&e.actionId==='enter'){s.amount=e.value;s.miles=Math.round(s.amount*62.1371)/100;}return {state:s};"
