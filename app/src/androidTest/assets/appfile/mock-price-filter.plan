# Request: Browse a small list of 12 used bikes with a price range filter, type chips like road, mountain and city, and sorting by price.
app("Used bikes", lang="en", preset="clean", palette="blue")
need price = input("range", "Price range (USD)", [0, 2000], min=0, max=2000, step=20)
need type = input("choice", "Bike type", "all", options={all: "All", road: "Road", mountain: "Mountain", city: "City"})
need order = input("choice", "Sort by price", "asc", options={asc: "Low to high", desc: "High to low"})
need bikes = entries("Bikes", fields={name: "text", detail: "text"}, show={cost: "$" + text($price)}, add=false, remove=false, icon="🚲", countText="Bikes matching", filter=$price >= $/price[0] && $price <= $/price[1] && ($/type == "all" || $type == $/type), sort=$price, order=$/order, rows=[{name: "Retrospec Beaumont", detail: "2019 · S · Good", type: "city", price: 260}, {name: "Brooklyn Bedford 8", detail: "2017 · One size · Fair", type: "city", price: 320}, {name: "Giant Contend 3", detail: "2018 · 56 cm · Good", type: "road", price: 480}, {name: "Trek Marlin 6", detail: "2021 · M · Good", type: "mountain", price: 540}, {name: "Specialized Sirrus X 2", detail: "2021 · M · Good", type: "city", price: 610}, {name: "Marin Bobcat Trail", detail: "2020 · L · Fair", type: "mountain", price: 650}, {name: "Fuji Sportif 2.3", detail: "2019 · 54 cm · Good", type: "road", price: 720}, {name: "Cannondale CAAD Optimo", detail: "2020 · 56 cm · Very good", type: "road", price: 980}, {name: "Scott Aspect 940", detail: "2022 · M · Very good", type: "mountain", price: 1040}, {name: "Bianchi Via Nirone 7", detail: "2021 · 55 cm · Good", type: "road", price: 1150}, {name: "Orbea Alma H50", detail: "2022 · L · Very good", type: "mountain", price: 1340}, {name: "Cube Kathmandu", detail: "2023 · M · Like new", type: "city", price: 1490}])
check("Range, type, and order", set(price_field, [500, 1000]), set(type_field, "road"), set(order_field, "desc"), expect(count($/bikes, $price >= $/price[0] && $price <= $/price[1] && $type == "road") == 2))
