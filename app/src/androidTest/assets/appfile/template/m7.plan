scene("Почему день сменяет ночь", lang="ru", palette="blue")
control = steps("Время", ["Утро", "День", "Вечер", "Ночь"], "Утро")
play = play("Вращение Земли", 0, 360, 10)
s1 = use("sun", 45, 150, 80)
s2 = use("earth", 195, 150, 130)
s3 = circle(195 + 52 * cos($/t), 150 - 52 * sin($/t), 9, "accent")
s4 = text(195, 260, $/v == "Ночь" ? "Город в тени" : "Город на свету", "ink", 14)
say1 = "Утром город выходит из тени на свет."
say2 = "Днём Солнце светит прямо на город."
say3 = "Вечером город уходит к краю света."
say4 = "Ночью город в тени Земли."
