scene("How a prism splits white light", lang="en", palette="indigo")
control = choice("Color of the light to follow", ["Violet light", "Indigo light", "Yellow light", "Orange light", "Purple light", "Golden light"], "Violet light")
s1 = rect(0, 160, 300, 60, "water", 0)
s2 = polygon([110, 150, 190, 150, 150, 70], "muted")
s3 = polygon([110, 150, 190, 150, 150, 70], "ink", stroke=true)
s4 = line(10, 110, 130, 110, "ink", 3)
s5 = line(170, 110, 290, 60, "#7c3aed", 3, visible=$/v == "Violet light")
s6 = line(170, 110, 290, 90, "#4f46e5", 3, visible=$/v == "Indigo light")
s7 = line(170, 110, 290, 120, "#facc15", 3, visible=$/v == "Yellow light")
s8 = circle(290, ($/v == "Orange light") ? 150 : 30, 6, "accent")
s9 = text(150, 14, "White light enters the glass prism.", "ink", 12)
s10 = text(150, 32, "Each color bends a little bit apart", "ink", 12)
s11 = text(150, 180, "Violet light bends the most of all.", "surface", 12)
s12 = text(150, 200, "Red light bends the least of colors", "surface", 12)
caption = "White light holds every color. In glass each color slows down by its own amount, so the colors come apartssss."
