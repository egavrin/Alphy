scene("How a glass prism splits white light.", lang="en", palette="indigo")
control = choice("Color of the light that you follow.", ["Violet sunlight", "Indigo sunlight", "Yellow sunlight", "Orange sunlight", "Purple sunlight", "Golden sunlight"], "Violet sunlight")
s1 = rect(0, 160, 300, 60, "water", 0)
s2 = polygon([110, 150, 190, 150, 150, 70], "muted")
s3 = polygon([110, 150, 190, 150, 150, 70], "ink", stroke=true)
s4 = line(10, 110, 130, 110, "ink", 3)
s5 = line(170, 110, 290, 60, "#7c3aed", 3, visible=$/v == "Violet sunlight")
s6 = line(170, 110, 290, 90, "#4f46e5", 3, visible=$/v == "Indigo sunlight")
s7 = line(170, 110, 290, 120, "#facc15", 3, visible=$/v == "Yellow sunlight")
s8 = circle(290, ($/v == "Orange sunlight") ? 150 : 30, 6, "accent")
s9 = text(150, 14, "White light enters the glass prism.", "ink", 12)
s10 = text(150, 32, "Each color bends a little bit apart", "ink", 12)
s11 = text(150, 180, "Violet light bends the most of all.", "surface", 12)
s12 = text(150, 200, "Red light bends the least of colors", "surface", 12)
card = card("Refraction bends each color differently.", "White light holds every color of the rainbow. In glass each color slows down by a different amount, so each one bends at its own angle, and the colors all come apart in a fan.")
