app("Как работает рычаг", lang="ru", preset="clean", palette="blue", kind="Объяснение")
need lever = drawing("Схема рычага", 300, 220, [line(35, 130, 265, 130, "ink", 6), polygon([150, 132, 130, 165, 170, 165], "accent"), line(150 - $/distance, 120 - $/force * 3, 150 - $/distance, 120, "warning", 4), polygon([150 - $/distance - 5, 112, 150 - $/distance + 5, 112, 150 - $/distance, 120], "warning"), line(230, 60, 230, 120, "ink", 4), polygon([225, 112, 235, 112, 230, 120], "ink"), text(230, 45, "Груз: 10 Н", "ink", 12), text(150, 185, "Опора", "ink", 12), text(150, 207, $/force * $/distance == 800 ? "Равновесие" : ($/force * $/distance > 800 ? "Сила перевешивает" : "Груз перевешивает"), "ink", 14)])
need force = input("number", "Сила, Н", 10, min=1, max=20, icon="Dumbbell")
need distance = input("number", "Плечо силы", 80, min=20, max=100, step=10, icon="Ruler")
need lesson = lesson([{title: "Опора и плечи", text: "Рычаг поворачивается вокруг опоры. Расстояние от опоры до силы называют плечом."}, {title: "Момент силы", text: "Сила действует тем сильнее, чем больше её плечо. Груз уравновешен, когда произведения силы на плечо с обеих сторон равны."}], next="Далее", back="Назад", stepText="Шаг")
need check = question("Как уменьшить силу, нужную для подъёма груза?", options=["Увеличить плечо силы", "Уменьшить плечо силы"], right="Увеличить плечо силы", rightText="Верно", wrongText="Попробуйте ещё раз")
