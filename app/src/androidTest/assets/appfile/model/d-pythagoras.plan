app("Теорема Пифагора", lang="ru", preset="clean", palette="blue", kind="Урок")
need triangle = drawing("Прямоугольный треугольник", 240, 240, [polygon([40, 200, 40 + 40 * $/scale, 200, 40, 200 - 30 * $/scale], "surface"), line(40, 200, 40 + 40 * $/scale, 200, "accent", 3), line(40, 200, 40, 200 - 30 * $/scale, "accent", 3), line(40, 200 - 30 * $/scale, 40 + 40 * $/scale, 200, "ink", 3), text(40 + 20 * $/scale, 220, text(4 * $/scale), "ink", 14), text(20, 200 - 15 * $/scale, text(3 * $/scale), "ink", 14), text(55 + 20 * $/scale, 190 - 15 * $/scale, text(5 * $/scale), "ink", 14)])
need scale = input("number", "Масштаб", 2, min=1, max=3, step=1, icon="Ruler")
need summary = card("Теорема Пифагора", "В прямоугольном треугольнике сумма квадратов катетов равна квадрату гипотенузы. Меняй масштаб и проверяй: 3² + 4² = 5².", icon="School")
need lesson = lesson([{title: "Стороны", text: "Катеты образуют прямой угол. Гипотенуза лежит напротив него и является самой длинной стороной."}, {title: "Формула", text: "Если катеты равны a и b, а гипотенуза равна c, то a² + b² = c²."}, {title: "Пример", text: "При катетах 3 и 4 получаем 9 + 16 = 25. Гипотенуза равна 5, потому что 5² = 25."}], next="Далее", back="Назад", stepText="Шаг")
need quiz = question("Катеты равны 6 и 8. Чему равна гипотенуза?", options=["10", "12", "14"], right="10", rightText="Верно: 6² + 8² = 10².", wrongText="Попробуй ещё: сложи квадраты катетов.")
