app("Used bikes", lang="en", preset="clean", palette="green", kind="Bike browser")
need price = input("range", "Price range", [0, 1000], min=0, max=1000, step=25)
need types = input("choices", "Bike type", [], options=["Road", "Mountain", "City"])
need order = input("choice", "Sort by price", "asc", options={asc: "Low to high", desc: "High to low"})
need bikes = entries("Used bikes", fields={name: "text", type: ["Road", "Mountain", "City"], price: "money"}, rows=[{name: "Sprint 100", type: "Road", price: 250}, {name: "Ridge 26", type: "Mountain", price: 320}, {name: "Metro Classic", type: "City", price: 180}, {name: "Velocity", type: "Road", price: 480}, {name: "Trail Fox", type: "Mountain", price: 550}, {name: "Urban Step", type: "City", price: 220}, {name: "Tourer", type: "Road", price: 375}, {name: "Peak 29", type: "Mountain", price: 690}, {name: "Commuter", type: "City", price: 300}, {name: "Aero Sport", type: "Road", price: 750}, {name: "Forest Ride", type: "Mountain", price: 400}, {name: "City Cruiser", type: "City", price: 275}], labels={name: "Bike", type: "Type", price: "Price"}, icon="🚲", add=false, remove=false, filter=$price >= $/price[0] && $price <= $/price[1] && (count($/types) == 0 || has($/types, $type)), sort=$price, order=$/order, countText="Bikes shown", total="of", emptyText="No bikes match these filters")
