app("BMI calculator", lang="en", preset="clean", palette="teal", kind="Calculator")
need bmi = figure("number", "BMI", $/weight / pow($/height / 100, 2), example=[{height: 200, weight: 80}, 20], decimals=1, icon="⚖️")
need range = figure("text", "BMI range", $/weight / pow($/height / 100, 2) < 18.5 ? "Underweight" : $/weight / pow($/height / 100, 2) < 25 ? "Healthy weight" : $/weight / pow($/height / 100, 2) < 30 ? "Overweight" : "Obesity", example=[{height: 200, weight: 80}, "Healthy weight"], icon="Chart")
need height = input("number", "Height in cm", 170, min=1, max=300, icon="Ruler")
need weight = input("number", "Weight in kg", 70, min=1, max=500, icon="Weight")
