app("Времена года", lang="ru", preset="soft", palette="blue", kind="Объяснение")
$/x := $/season == "Лето" ? 50 : $/season == "Зима" ? 250 : 150
$/y := $/season == "Весна" ? 50 : $/season == "Осень" ? 250 : 150
need diagram = drawing("Земля на орбите вокруг Солнца", 300, 300, [circle(150, 150, 100, "accent", stroke=true), circle(150, 150, 24, "sun"), text(150, 150, "Солнце", "ink", 11), circle($/x, $/y, 14, "water"), line($/x - 12, $/y + 24, $/x + 12, $/y - 24, "ink", 3), text($/x + 20, $/y - 26, "С", "ink", 12)])
need season = input("choice", "Время года в Северном полушарии", "Лето", options=["Весна", "Лето", "Осень", "Зима"])
need explanation = card("Наклон земной оси", "Земная ось наклонена, поэтому в течение года полушария получают разное количество солнечного света. Времена года возникают не из-за расстояния до Солнца.", icon="Globe")
need lesson = lesson([{title: "Земля обращается вокруг Солнца", text: "За год Земля проходит полный круг, сохраняя почти одно направление наклона оси."}, {title: "Лето и зима", text: "Когда полушарие наклонено к Солнцу, дни длиннее и лучи падают прямее: наступает лето. Когда оно наклонено от Солнца, дни короче и наступает зима."}, {title: "Весна и осень", text: "Между летом и зимой освещённость постепенно меняется. В Южном полушарии времена года противоположны северным."}], next="Далее", back="Назад", stepText="Шаг")
need quiz = question("Почему в Северном полушарии бывает лето?", options=["Оно наклонено к Солнцу", "Земля значительно ближе к Солнцу"], right="Оно наклонено к Солнцу", rightText="Верно!", wrongText="Подумай о наклоне оси.")
