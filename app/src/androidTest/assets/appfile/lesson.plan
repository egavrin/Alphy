app("Почему Луна не отворачивается?", lang="ru", kind="Alphy Learn", preset="clean", palette="teal")
need orbit = drawing("Земля в центре, Луна на орбите и метка её стороны", 320, 320, [circle(160, 160, 110, "muted", stroke=true), line(160, 160, 160 + 110 * cos($/angle), 160 - 110 * sin($/angle), "accent", width=1, visible=$/lesson >= 2), circle(160, 160, 34, "water"), text(160, 160, "Земля", "surface", size=12), circle(160 + 110 * cos($/angle), 160 - 110 * sin($/angle), 18, "sand"), circle(160 + 110 * cos($/angle) + 18 * cos($/mode == "С вращением" ? $/angle + 180 : 180), 160 - 110 * sin($/angle) - 18 * sin($/mode == "С вращением" ? $/angle + 180 : 180), 5, "accent")])
need angle = input("number", "Положение на орбите", 40, min=0, max=360, step=5)
need mode = input("choice", "Вращение Луны", "С вращением", options=["С вращением", "Без вращения"])
need lap = button("Один круг", [set($/angle, 0), animate($/angle, 360, 5000)])
need lesson = lesson([{title: "Следи за бирюзовой меткой", text: "Один оборот вокруг оси за один круг вокруг Земли. Поэтому к нам обращена примерно одна и та же сторона."}, {title: "Метка всё время обращена к Земле", text: "Я добавил направляющую. Двигай Луну вокруг Земли и следи за направлением бирюзовой метки."}, {title: "А если не вращать?", text: "Попробуй режим «Без вращения» и передвинь Луну. Метка уже не всё время смотрит на Землю."}], next="Дальше", back="Назад", stepText="Исследуем")
need ask = question("Если Луна не вращается вокруг оси, мы видим только одну её сторону?", options=["Да", "Нет"], right="Нет", rightText="Верно! Без вращения к Земле обращались бы разные стороны.", wrongText="Попробуй режим «Без вращения» и передвинь Луну.")
