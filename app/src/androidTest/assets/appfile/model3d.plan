app("Собираем лунного ровера", lang="ru", kind="Мастерская", preset="playful", palette="teal")
need rover = model3d("Живая 3D-сцена", [box("", 0, 0.9, 0, 3, 0.6, 1.7, "surface"), cylinder("wheels", -1.1, 0.4, 1, 0.42, 0.3, "z", "ink"), cylinder("wheels", 1.1, 0.4, 1, 0.42, 0.3, "z", "ink"), cylinder("wheels", -1.1, 0.4, -1, 0.42, 0.3, "z", "ink"), cylinder("wheels", 1.1, 0.4, -1, 0.42, 0.3, "z", "ink"), cylinder("camera", 1, 1.6, 0, 0.07, 0.8, "y", "muted"), box("camera", 1, 2.2, 0, 0.5, 0.4, 0.4, "accent"), cylinder("panel", -1, 1.3, 0, 0.06, 0.2, "y", "muted"), box("panel", -1, 1.4, 0, 1.6, 0.08, 1.5, "#28425c")], parts={camera: "Камера", panel: "Панель", wheels: "Колёса"}, explode=true, turn=true, explodeText="Разобрать", joinText="Собрать")
need focus = card($/rover/selected == "camera" ? "Камера на мачте" : $/rover/selected == "panel" ? "Солнечная панель" : $/rover/selected == "wheels" ? "Четыре широких колеса" : "Твой лунный вездеход", $/rover/selected == "camera" ? "В этой концепции камера поднята над корпусом. Так ей удобнее смотреть по сторонам." : $/rover/selected == "panel" ? "В нашей концепции панель питает ровера от света." : $/rover/selected == "wheels" ? "В эскизе широкие колёса помогают показать характер машины." : "Выбери деталь на модели или спроси о ней. Пояснение появится здесь.", eyebrow="В фокусе")
