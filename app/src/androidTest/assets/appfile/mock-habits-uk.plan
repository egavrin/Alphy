# Request: Трекер звичок на тиждень: три звички, відмітки по днях і серія днів поспіль для кожної.
app("Трекер звичок", lang="uk", preset="soft", palette="green")
need week = progress("Виконано за тиждень", sum($/habits, count([$pn, $vt, $sr, $cht, $pt, $sb, $nd], $it)), 21)
need habits = entries("Звички", fields={sign: "text", name: "text", pn: "check", vt: "check", sr: "check", cht: "check", pt: "check", sb: "check", nd: "check"}, labels={pn: "Пн", vt: "Вт", sr: "Ср", cht: "Чт", pt: "Пт", sb: "Сб", nd: "Нд"}, show={days: text(count([$pn, $vt, $sr, $cht, $pt, $sb, $nd], $it)) + " з 7", streak: "🔥 " + text(streak([$pn, $vt, $sr, $cht, $pt, $sb, $nd]))}, tones={streak: "accent"}, icon=$sign, add=false, remove=false, rows=[{sign: "💧", name: "Пити воду", pn: true, vt: true, sr: false, cht: false, pt: false, sb: false, nd: false}, {sign: "📖", name: "Читати 20 сторінок", pn: true, vt: false, sr: false, cht: false, pt: false, sb: false, nd: false}, {sign: "🚶", name: "Прогулянка 30 хв", pn: false, vt: false, sr: false, cht: false, pt: false, sb: false, nd: false}])
check("Відмітки рахують тиждень", expect($/week == 3 && $/week_goal == 21), set(habits_sr, true, row=0), expect($/week == 4))
