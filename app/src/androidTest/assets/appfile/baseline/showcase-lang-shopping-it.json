 "source": "const s=input.state,e=input.event;\nconst A={frutta:['Frutta e verdura','🥬'],panetteria:['Panetteria','🥖'],latticini:['Latticini','🧀'],carne:['Carne e pesce','🥩'],surgelati:['Surgelati','🧊'],dispensa:['Dispensa','🥫'],bevande:['Bevande','🧃'],igiene:['Igiene','🧴'],casa:['Casa','🧹'],altro:['Altro','🛒']};\nconst O=['frutta','panetteria','latticini','carne','surgelati','dispensa','bevande','igiene','casa','altro'];\nfunction info(id){const a=A[id]||A.altro;const i=O.indexOf(id);return {name:a[0],emoji:a[1],order:i<0?99:i};}\nfunction rebuild(){\n let rows=s.items.slice();\n if(s.filter==='dacomprare')rows=rows.filter(function(x){return !x.done;});\n if(s.filter==='comprati')rows=rows.filter(function(x){return x.done;});\n rows.sort(function(a,b){\n  if(a.done!==b.done)return a.done?1:-1;\n  if(s.sortMode==='corsia'){const d=info(a.aisle).order-info(b.aisle).order;if(d)return d;}\n  return a.created-b.created;\n });\n s.view=rows.map(function(x){const i=info(x.aisle);const q=(x.qty||'').trim();return {id:x.id,name:x.name,emoji:i.emoji,detail:q?q+' · '+i.name:i.name,done:x.done};});\n const done=s.items.filter(function(x){return x.done;}).length,total=s.items.length;\n s.remaining=total-done;\n s.totalText=total?(done+' di '+total+' presi'):'Nessun prodotto';\n}\nif(e.type==='action'||e.type==='liveInput'){\n const v=e.value,id=e.actionId;\n if(id==='draftName'||id==='editName'||id==='editQty')s[id]=String(v);\n if(id==='draftAisle'||id==='editAisle'||id==='filter'||id==='sortMode')s[id]=String(v);\n if(id==='add'){const n=(s.draftName||'').trim();if(n&&s.items.length<100){s.items.push({id:'p'+s.nextId,name:n,qty:'',aisle:A[s.draftAisle]?s.draftAisle:'altro',done:false,created:s.nextId});s.nextId=s.nextId+1;s.draftName='';}}\n if(id==='done'){const it=s.items.find(function(x){return x.id===v.key;});if(it)it.done=!!v.value;}\n if(id==='edit'){const it=s.items.find(function(x){return x.id===v.key;});if(it){s.editId=it.id;s.editName=it.name;s.editQty=it.qty;s.editAisle=it.aisle;s.dialogOpen=true;}}\n if(id==='save'){const it=s.items.find(function(x){return x.id===s.editId;});if(it){const n=(s.editName||'').trim();if(n)it.name=n;it.qty=(s.editQty||'').trim();if(A[s.editAisle])it.aisle=s.editAisle;}s.dialogOpen=false;s.editId='';}\n if(id==='remove'){s.items=s.items.filter(function(x){return x.id!==s.editId;});s.dialogOpen=false;s.editId='';}\n if(id==='closeDialog'){s.dialogOpen=false;s.editId='';}\n if(id==='clearBought'){s.items=s.items.filter(function(x){return !x.done;});}\n rebuild();\n}\nreturn {state:s};",
 "formatVersion": 3,
 "appLanguage": "it"
