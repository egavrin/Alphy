 "source": "const s=input.state,e=input.event,a=e.actionId||'';\nconst D={1:['h1d0','h1d1','h1d2','h1d3','h1d4','h1d5','h1d6'],2:['h2d0','h2d1','h2d2','h2d3','h2d4','h2d5','h2d6'],3:['h3d0','h3d1','h3d2','h3d3','h3d4','h3d5','h3d6']};\nconst N={n1:'h1name',n2:'h2name',n3:'h3name'};\nif(e.type==='action'||e.type==='liveInput'){\n if(/^h[123]d[0-6]$/.test(a)){s[a]=!!e.value;}\n if(N[a])s[N[a]]=String(e.value||'');\n if(a==='openEdit')s.editOpen=true;\n if(a==='closeEdit'||a==='closeEdit2')s.editOpen=false;\n if(a==='reset'){Object.keys(D).forEach(k=>D[k].forEach(d=>{s[d]=false;}));}\n}\nif(e.type!=='preview'&&e.type!=='render'){\n const today=(new Date(Date.now()).getDay()+6)%7;\n let total=0;\n [1,2,3].forEach(k=>{\n  const ds=D[k];let done=0;\n  ds.forEach(d=>{if(s[d])done++;});\n  total+=done;\n  s['d'+k]=done+' з 7';\n  let i=s[ds[today]]?today:today-1,st=0;\n  while(i>=0&&s[ds[i]]){st++;i--;}\n  s['s'+k]='🔥 '+st;\n });\n s.total=total;\n s.totalText=total+' з 21';\n}\nreturn {state:s};",
