 "source": "const s=input.state,e=input.event,v=e.value;\nif(e.type!=='action'&&e.type!=='liveInput')return {state:input.state};\nconst D={mąka:0.55,cukier:0.85,woda:1};\nconst NAME={mąka:'Mąka',cukier:'Cukier',woda:'Woda'};\nconst PIC={mąka:'🌾',cukier:'🍬',woda:'💧'};\nconst GEN={mąka:'mąki',cukier:'cukru',woda:'wody'};\nconst SHORT={g:'g',szklanka:'szkl.',łyżka:'łyż.',ml:'ml'};\nconst LONG={g:'Gramy',szklanka:'Szklanki',łyżka:'Łyżki',ml:'Mililitry'};\nconst nf=new Intl.NumberFormat('pl-PL',{maximumFractionDigits:1});\nconst f=function(x){return nf.format(x)};\nif(e.actionId==='ingredient')s.ingredient=v;\nif(e.actionId==='unit')s.unit=v;\nif(e.actionId==='amount')s.amount=Number(v);\nconst d=D[s.ingredient]||1;\nconst toMl={g:1/d,szklanka:250,'łyżka':15,ml:1};\nconst a=Math.max(0,Number(s.amount)||0);\nconst ml=a*(toMl[s.unit]||1);\nconst vals={g:ml*d,szklanka:ml/250,'łyżka':ml/15,ml:ml};\nconst order=['g','szklanka','łyżka','ml'];\ns.name=NAME[s.ingredient];\ns.picture=PIC[s.ingredient];\ns.amountText=f(a)+' '+SHORT[s.unit];\ns.conversions=order.filter(function(u){return u!==s.unit}).map(function(u){return {id:'u_'+order.indexOf(u),label:LONG[u],value:f(vals[u])}});\ns.assumptions='Gęstość '+GEN[s.ingredient]+' ok. '+f(d)+' g/ml. 1 szklanka '+GEN[s.ingredient]+' ≈ '+f(250*d)+' g, 1 łyżka ≈ '+f(15*d)+' g.';\nreturn {state:s};",
 "formatVersion": 3,
 "appLanguage": "pl"
}
