# Request: Una lista della spesa dove aggiungo prodotti, li spunto quando li compro e posso riordinarli per corsia del supermercato.
app("Lista della spesa", lang="it", preset="soft", palette="green")
need left = figure("count", "Da comprare", count($/prodotti, !$preso), icon="🛒", note="In ordine di corsia")
need prodotti = entries("Prodotti", fields={nome: "text", corsia: ["Frutta e verdura", "Panetteria", "Latticini", "Carne e pesce", "Surgelati", "Dispensa", "Bevande", "Casa"], preso: "check"}, labels={nome: "Prodotto", corsia: "Corsia", preso: "Preso"}, show={segno: $corsia == "Frutta e verdura" ? "🍎" : $corsia == "Panetteria" ? "🥖" : $corsia == "Latticini" ? "🥛" : $corsia == "Carne e pesce" ? "🐟" : $corsia == "Surgelati" ? "🧊" : $corsia == "Bevande" ? "🧃" : $corsia == "Casa" ? "🧽" : "🥫"}, icon=$segno, sort=$corsia, rows=[])
check("Aggiungi e spunta", set(prodotti_new_nome, "Latte"), set(prodotti_new_corsia, "Latticini"), tap(prodotti_add), expect($/left == 1), set(prodotti_preso, true, row=0), expect($/left == 0))
