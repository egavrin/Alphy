  {
    "id": "d-pythagoras",
    "kind": "scenario",
    "name": "A scale of 3 draws the sides 9, 12, and 15; the next step shows the formula; the answer 10 (the root of 36 + 64) is right",
    "steps": [
      {"expect": "text", "contains": "Стороны"},
      {"set": "scale_field", "value": 3},
      {"expect": "text", "contains": "15"},
      {"tap": "lesson_next"},
      {"expect": "text", "contains": "Формула"},
      {"expect": "absent", "contains": "Верно"},
      {"tap": "quiz_opt0"},
      {"expect": "text", "contains": "Верно"}
    ]
  },
  {
    "id": "d-moon",
    "kind": "scenario",
    "name": "The angle field takes 90; the next step explains the turn of the Moon; the answer two is wrong and the answer one is right",
    "steps": [
      {"set": "angle_field", "value": 90},
      {"expect": "value", "target": "angle", "equals": 90},
      {"tap": "lesson_next"},
      {"expect": "text", "contains": "Вращение Луны"},
      {"tap": "quiz_opt2"},
      {"expect": "text", "contains": "Попробуйте ещё раз"},
      {"tap": "quiz_opt0"},
      {"expect": "text", "contains": "Верно"}
    ]
  },
  {
    "id": "e-plank-fr",
    "kind": "known item",
    "name": "5 rounds of 45 s with 15 s of rest between them: at 50 s the first rest runs, and at 290 s the timer is over (5 x 45 + 4 x 15 = 285 s)",
    "steps": [
      {"tap": "planche_start"},
      {"wait": 50000},
      {"expect": "text", "contains": "Repos"},
      {"wait": 240000},
      {"expect": "text", "contains": "Terminé"}
    ]
  },
  {
    "id": "e-score-zh",
    "kind": "known item",
    "name": "The buttons of the hole: two adds and one subtraction give team one 1, one add gives team two 1, and the reset gives 0",
    "steps": [
      {"tap": "teamAmore"},
      {"tap": "teamAmore"},
      {"tap": "teamAless"},
      {"tap": "teamBmore"},
      {"expect": "value", "target": "teamA", "equals": 1},
      {"expect": "value", "target": "teamB", "equals": 1},
      {"tap": "reset"},
      {"expect": "value", "target": "teamA", "equals": 0}
    ]
  },
  {
    "id": "showcase-ui-priorities-v5",
    "kind": "scenario",
    "name": "Top five tasks: the count starts at 0 / 5; five tasks give 5 / 5, the text of a full list, and no add form; the fifth task moved to the first place is the row that a delete of the first row removes, and then the count is 4 / 5 and the form is back; a sixth task fills the list again",
    "steps": [
      {"expect": "value", "target": "d.tasks_hero_1_value", "equals": "0 / 5"},
      {"expect": "absent", "contains": "The list is full"},
      {"set": "tasks_new_task", "value": "Email the client"},
      {"set": "tasks_new_priority", "value": "High"},
      {"tap": "tasks_add"},
      {"set": "tasks_new_task", "value": "Write the report"},
      {"set": "tasks_new_priority", "value": "High"},
      {"tap": "tasks_add"},
      {"set": "tasks_new_task", "value": "Book the dentist"},
      {"set": "tasks_new_priority", "value": "Medium"},
      {"tap": "tasks_add"},
      {"set": "tasks_new_task", "value": "Pay the rent"},
      {"set": "tasks_new_priority", "value": "Low"},
      {"tap": "tasks_add"},
      {"set": "tasks_new_task", "value": "Call the bank"},
      {"set": "tasks_new_priority", "value": "Medium"},
      {"tap": "tasks_add"},
      {"expect": "value", "target": "d.tasks_hero_1_value", "equals": "5 / 5"},
      {"expect": "text", "contains": "The list is full"},
      {"expect": "disabled", "target": "tasks_add"},
      {"expect": "disabled", "target": "tasks_new_task"},
      {"expect": "text", "contains": "Call the bank"},
      {"set": "tasks_list_move", "value": {"sourceKey": "r5", "destinationKey": "r1"}},
      {"tap": "tasks_remove", "row": 0},
      {"expect": "absent", "contains": "Call the bank"},
      {"expect": "text", "contains": "Email the client"},
      {"expect": "value", "target": "d.tasks_hero_1_value", "equals": "4 / 5"},
      {"expect": "enabled", "target": "tasks_add"},
      {"expect": "absent", "contains": "The list is full"},
      {"set": "tasks_new_task", "value": "Plan the week"},
      {"set": "tasks_new_priority", "value": "Low"},
      {"tap": "tasks_add"},
      {"expect": "value", "target": "d.tasks_hero_1_value", "equals": "5 / 5"},
      {"expect": "text", "contains": "The list is full"},
      {"expect": "disabled", "target": "tasks_add"},
      {"expect": "text", "contains": "Plan the week"},
      {"expect": "text", "contains": "Low"}
    ]
  },
  {
    "id": "showcase-lang-budget-es-v5b",
    "kind": "scenario",
    "name": "The summary tab starts with a month total of 0,00; three expenses of today, 12.25 and 7.50 for Comida and 3.75 for Transporte, give a month total of 23,50 (12.25 + 7.50 + 3.75) and the line Comida: 19,75 · Transporte: 3,75 beside the chart",
    "steps": [
      {"expect": "value", "target": "d.total_text", "equals": "0,00"},
      {"set": "pestanas_view", "value": "Añadir gastos"},
      {"set": "gastos_new_categoria", "value": "Comida"},
      {"set": "gastos_new_importe", "value": 12.25},
      {"tap": "gastos_add"},
      {"set": "gastos_new_categoria", "value": "Comida"},
      {"set": "gastos_new_importe", "value": 7.5},
      {"tap": "gastos_add"},
      {"set": "gastos_new_categoria", "value": "Transporte"},
      {"set": "gastos_new_importe", "value": 3.75},
      {"tap": "gastos_add"},
      {"set": "pestanas_view", "value": "Resumen"},
      {"expect": "value", "target": "d.total_text", "equals": "23,50"},
      {"expect": "value", "target": "d.desglose_view_text", "equals": "Comida: 19,75 · Transporte: 3,75"},
      {"expect": "text", "contains": "Gastos por categoría"}
    ]
  },
  {
    "id": "holdout-study-ja-v5b",
    "kind": "scenario",
    "name": "Two records of 数学 today, 1.5 and 0.75 hours, and one of 英語, 1.25 hours, give a week total of 3.5 時間 (1.5 + 0.75 + 1.25) and the line 数学: 2.25時間 · 英語: 1.25時間",
    "steps": [
      {"expect": "value", "target": "d.weekly_text", "equals": "0 時間"},
      {"tap": "study_addRow_open"},
      {"set": "study_new_subject", "value": "数学"},
      {"set": "study_new_hours", "value": 1.5},
      {"tap": "study_add"},
      {"tap": "study_addRow_open"},
      {"set": "study_new_subject", "value": "数学"},
      {"set": "study_new_hours", "value": 0.75},
      {"tap": "study_add"},
      {"tap": "study_addRow_open"},
      {"set": "study_new_subject", "value": "英語"},
      {"set": "study_new_hours", "value": 1.25},
      {"tap": "study_add"},
      {"expect": "value", "target": "d.weekly_text", "equals": "3.5 時間"},
      {"expect": "value", "target": "d.bySubject_view_text", "equals": "数学: 2.25時間 · 英語: 1.25時間"}
    ]
  },
  {
    "id": "showcase-ui-trip-dates-v5",
    "kind": "scenario",
    "name": "The trip starts on the coming Saturday and ends on the Sunday after it; activities added as Sunday 10:00, Saturday 15:00, and Saturday 09:00 show in the order of day and time: a delete of the first row removes the breakfast, and then a delete of the second row removes the hike; the two come back in the sheet",
    "steps": [
      {"expect": "value", "target": "start_field", "equals": "{saturday}"},
      {"expect": "value", "target": "end_field", "equals": "{sunday}"},
      {"tap": "itinerary_open"},
      {"set": "itinerary_new_day", "value": "{sunday}"},
      {"set": "itinerary_new_time", "value": 600},
      {"set": "itinerary_new_activity", "value": "Hike to the lake"},
      {"tap": "itinerary_add"},
      {"tap": "itinerary_open"},
      {"set": "itinerary_new_day", "value": "{saturday}"},
      {"set": "itinerary_new_time", "value": 900},
      {"set": "itinerary_new_activity", "value": "City museum"},
      {"tap": "itinerary_add"},
      {"tap": "itinerary_open"},
      {"set": "itinerary_new_day", "value": "{saturday}"},
      {"set": "itinerary_new_time", "value": 540},
      {"set": "itinerary_new_activity", "value": "Breakfast at the hotel"},
      {"tap": "itinerary_add"},
      {"expect": "value", "target": "d.itinerary_hero_1_value", "equals": 3},
      {"tap": "itinerary_remove", "row": 0},
      {"expect": "absent", "contains": "Breakfast at the hotel"},
      {"expect": "text", "contains": "City museum"},
      {"expect": "text", "contains": "Hike to the lake"},
      {"tap": "itinerary_remove", "row": 1},
      {"expect": "absent", "contains": "Hike to the lake"},
      {"expect": "text", "contains": "City museum"},
      {"tap": "itinerary_open"},
      {"set": "itinerary_new_day", "value": "{saturday}"},
      {"set": "itinerary_new_time", "value": 540},
      {"set": "itinerary_new_activity", "value": "Breakfast at the hotel"},
      {"tap": "itinerary_add"},
      {"tap": "itinerary_open"},
      {"set": "itinerary_new_day", "value": "{sunday}"},
      {"set": "itinerary_new_time", "value": 600},
      {"set": "itinerary_new_activity", "value": "Hike to the lake"},
      {"tap": "itinerary_add"},
      {"expect": "value", "target": "d.itinerary_hero_1_value", "equals": 3}
    ]
  }
]
