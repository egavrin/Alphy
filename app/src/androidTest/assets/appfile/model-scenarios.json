[
  {
    "id": "holdout-tip-ru",
    "kind": "scenario",
    "name": "A bill of 800 with a tip of 15 % for 4 people is 230,00 for each person (800 x 1.15 / 4); the start values give 550,00 (1000 x 1.10 / 2)",
    "steps": [
      {"expect": "value", "target": "d.perperson_text", "equals": "550,00"},
      {"set": "bill_field", "value": 800},
      {"set": "tip_field", "value": 15},
      {"set": "people_field", "value": 4},
      {"expect": "value", "target": "d.perperson_text", "equals": "230,00"},
      {"expect": "text", "contains": "230,00"}
    ]
  },
  {
