  {
    "id": "showcase-lang-habits-uk",
    "kind": "scenario",
    "name": "Three habits get their names, and one mark on Monday gives a streak of 1 on each day of the week (the list of each row holds Monday and the days up to today)",
    "steps": [
      {"set": "habits_habit", "row": 0, "value": "Біг"},
      {"set": "habits_habit", "row": 1, "value": "Читання"},
      {"set": "habits_habit", "row": 2, "value": "Вода"},
      {"expect": "absent", "contains": "1"},
      {"set": "habits_mon", "row": 0, "value": true},
      {"expect": "text", "contains": "Біг"},
      {"expect": "text", "contains": "1"},
      {"expect": "value", "target": "d.habits_hero_1_value", "equals": 3}
    ]
  },
  {
    "id": "showcase-lang-tea-tr",
    "kind": "scenario",
    "name": "Each tea gives its own countdown and the alert vibrates; the plan gives black 300 s, green 180 s, and herbal 420 s; the checker cannot press the host Start",
