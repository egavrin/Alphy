# Each item of the catalog that came after the final run: time and date fields, tabs, a dialog, groups, a count in a row, pages, a picture, a typed quiz, choices.
app("Weekend", lang="en", preset="clean", palette="indigo")
need photo = picture("A lake in the hills at sunrise")
need bed = input("time", "Went to bed", "23:00")
need wake = input("time", "Woke up", "07:00")
need slept = figure("number", "Hours slept", hours($/bed, $/wake), example=[{bed: "23:30", wake: "06:00"}, 6.5], decimals=1)
need start = input("date", "Trip starts", "2026-11-21")
need doses = entries("Doses", fields={name: "text", time: "time", on: "switch", taken: "count"}, edit=true, confirm="Delete this dose?", yes="Delete", no="Keep", rows=[{name: "Morning", time: "08:00", on: true, taken: 0}, {name: "Noon", time: "14:00", on: true, taken: 0}, {name: "Night", time: "20:00", on: false, taken: 0}], labels={name: "Dose", time: "Time", on: "", taken: "Taken"}, addText="Add dose", emptyText="No doses")
need acts = entries("Itinerary", fields={what: "text", day: ["Saturday", "Sunday"], time: "time"}, sheet=true, group=$day, sort=[$day, $time], rows=[{what: "Hike", day: "Sunday", time: "09:00"}, {what: "Dinner", day: "Saturday", time: "19:00"}, {what: "Museum", day: "Saturday", time: "10:00"}], labels={what: "Activity", day: "Day", time: "Time"}, addText="Add activity", emptyText="No activities")
need gear = input("choices", "Take with you, three at most", ["Map"], options=["Map", "Tent", "Stove", "Camera", "Book"], max=3)
need packed = figure("count", "Things packed", count($/gear), example=[{gear: ["Map", "Tent"]}, 2])
need perDay = chart("Activities for each day", groups($/acts, $day), $key, $value)
need pagesData = entries("Pages", fields={line: "text"}, hidden=true, rows=[{line: "A fox woke up early."}, {line: "It walked to the lake."}, {line: "It came home at night."}])
need book = deck("Story", $/pagesData, front=$line, next="Next", prev="Back", again="Read again", done="The end")
need verbs = entries("Verbs", fields={q: "text", a: "text", drawing: "picture"}, hidden=true, rows=[{q: "parler, je", a: "parle", drawing: "Two people who talk"}, {q: "finir, nous", a: "finissons", drawing: "A finish line"}])
need quiz = deck("Quiz", $/verbs, front=$q, answer=$a, picture=$drawing)
need pages = tabs(["Sleep", "Doses", "Trip", "Story", "Quiz"], [[slept, bed, wake, start], [doses], [acts, gear, packed, perDay], [pagesData, book], [verbs, quiz]])
