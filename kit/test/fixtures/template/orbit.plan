scene("Земля вокруг Солнца", lang="ru", palette="indigo")
play = play("Движение", 0, 360, 12)
s1 = circle(150, 150, 110, "ink", stroke=true)
s2 = use("sun", 150, 150, 70)
s3 = use("earth", 150 + 110 * cos($/t), 150 - 110 * sin($/t), 34)
s4 = use("moon", 150 + 110 * cos($/t) + 32 * cos(12 * $/t), 150 - 110 * sin($/t) - 32 * sin(12 * $/t), 24)
caption = "Земля обходит Солнце за год, а Луна обходит Землю примерно за месяц."
say = "Смотри, как Земля идёт по кругу, а Луна кружит рядом с ней."
