# Request: 하루 물 마시기 기록 앱을 만들어 줘. 컵 버튼을 누르면 250ml씩 추가되고 목표 2리터 대비 진행률을 보여 줘.
# Components only, in the tree of the baseline showcase-lang-water-ko. The last two metrics show how a Metric prints 1234.5: from a state value and from a computed value.
app("하루 물 마시기", lang="ko", preset="clean", palette="blue")
$/ml = 0
$/n = 1234.5
root = Column([hero, cup, hint, figures, done, manage, numbers])
hero = Card([Emoji("💧", size="large"), Metric("오늘 마신 양", $/ml + " ml", emphasis="display"), Progress($/ml, 2000, label="달성률")], variant="hero")
cup = Button("컵 추가 (250 ml)", inc($/ml, 250), variant="filled", icon="Cup")
hint = Text("컵 한 번에 250 ml가 더해져요.", tone="muted")
figures = Grid([Metric("남은 양", max(0, 2000 - $/ml) + " ml", icon="Drop"), Metric("하루 목표", "2,000 ml", icon="Target")], columns=2)
done = Notice("오늘 목표 2 L를 달성했어요 🎉", tone="success", icon="Trophy", visible=$/ml >= 2000)
manage = Section("기록 관리", [reset])
reset = Button("하루 리셋", set($/ml, 0), variant="text", icon="Refresh")
numbers = Grid([Metric("Plain", $/n), Metric("Computed", $/n * 1)], columns=2)
check("컵 세 번, 리셋", tap(cup), tap(cup), tap(cup), expect($/ml == 750), tap(reset), expect($/ml == 0))
