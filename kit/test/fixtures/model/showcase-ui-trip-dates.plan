app("Weekend trip", lang="en", preset="soft", palette="blue", kind="Trip planner")
need start = input("date", "Travel start", today(), icon="Calendar")
need end = input("date", "Travel end", today(), icon="Calendar")
need activities = entries("Activities", fields={name: "text", day: "date", time: "time"}, rows=[], labels={name: "Activity", day: "Day", time: "Time"}, addText="Add activity", emptyText="No activities yet", icon="🧳", icons={name: "Spark", day: "Calendar", time: "Clock"}, sheet=true, sort=[$day, $time])
need timeline = hole("Show the activities within the selected travel dates as a chronological itinerary timeline.")
timeline_view = Column([timeline_title, timeline_list])
timeline_title = Heading("Itinerary timeline")
timeline_list = List(sort(filter($/activities, $day >= $/start && $day <= $/end), [$day, $time], "asc"), timeline_row, empty="No activities in these dates")
timeline_row = Row([timeline_marker, timeline_detail])
timeline_marker = Emoji("📍", size="small")
timeline_detail = Column([timeline_date, timeline_name], gap="small")
timeline_date = Text($day + " · " + $time, emphasis="label")
timeline_name = Text($name)
