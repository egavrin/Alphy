app("Sleep log", lang="en", preset="soft", palette="indigo")
need average = figure("number", "Weekly average", count(filter($/nights, $night >= addDays(today(), -6) && $night <= today())) > 0 ? avg(filter($/nights, $night >= addDays(today(), -6) && $night <= today()), hours($bedtime, $wake)) : 0, example=[{nights: [{night: today(), bedtime: "23:00", wake: "07:00"}, {night: addDays(today(), -1), bedtime: "00:00", wake: "06:00"}]}, 7], decimals=1, icon="🌙", unit="hours", note="Last 7 days")
need nights = entries("Sleep log", fields={night: "date", bedtime: "time", wake: "time"}, rows=[], labels={night: "Night", bedtime: "Bedtime", wake: "Wake time", slept: "Hours slept"}, show={slept: hours($bedtime, $wake)}, icon="🛌", icons={night: "Calendar", bedtime: "Moon", wake: "Sun"}, addText="Add night", emptyText="No sleep recorded yet")
