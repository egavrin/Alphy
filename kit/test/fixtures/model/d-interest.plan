app("Сложный процент", lang="ru", preset="soft", palette="green", kind="Объяснение")
need visual = drawing("Рост вклада", 300, 220, [rect(45, 80, 70, 100, "land", 8), rect(185, 180 - 100 * pow(1.1, $/years), 70, 100 * pow(1.1, $/years), "accent", 8), text(80, 65, "10 000 ₽", "ink", 14), text(220, 165 - 100 * pow(1.1, $/years), fixed(10000 * pow(1.1, $/years), 0) + " ₽", "ink", 14), text(80, 202, "В начале", "ink", 13), text(220, 202, "Через лет: " + text($/years), "ink", 13)])
need years = input("number", "Лет на вкладе", 2, min=0, max=5, step=1, icon="Clock")
need explanation = card("Проценты на проценты", "Сложный процент означает, что начисленные проценты прибавляются к вкладу и тоже приносят доход. Здесь вклад растёт на 10% в конце каждого года, без снятий и налогов.", icon="Sprout")
need lesson = lesson([{title: "Первый год", text: "На 10 000 ₽ начисляется 10%, или 1 000 ₽. На счёте становится 11 000 ₽."}, {title: "Второй год", text: "Теперь 10% начисляется на 11 000 ₽: это 1 100 ₽. На счёте уже 12 100 ₽."}], next="Далее", back="Назад", stepText="Шаг")
need question = question("Сколько будет на вкладе через два года при 10% годовых и начальной сумме 10 000 ₽?", options=["12 000 ₽", "12 100 ₽", "11 000 ₽"], right="12 100 ₽", rightText="Верно!", wrongText="Попробуйте ещё раз")
