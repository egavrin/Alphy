app("Capitali europee", lang="it", preset="playful", palette="blue", kind="Flashcard")
need carte = entries("Carte", fields={paese: "text", capitale: "text", saputa: "check"}, rows=[{paese: "Italia", capitale: "Roma", saputa: false}, {paese: "Francia", capitale: "Parigi", saputa: false}, {paese: "Spagna", capitale: "Madrid", saputa: false}, {paese: "Germania", capitale: "Berlino", saputa: false}, {paese: "Portogallo", capitale: "Lisbona", saputa: false}, {paese: "Austria", capitale: "Vienna", saputa: false}, {paese: "Grecia", capitale: "Atene", saputa: false}, {paese: "Irlanda", capitale: "Dublino", saputa: false}, {paese: "Polonia", capitale: "Varsavia", saputa: false}, {paese: "Norvegia", capitale: "Oslo", saputa: false}], labels={paese: "Paese", capitale: "Capitale", saputa: "La sapevo"}, icon="🌍", hidden=true)
need mazzo = deck("Capitali europee", $/carte, front=$paese, back=$capitale, mark=$saputa, show="Mostra la risposta", yes="La sapevo", no="Non la sapevo", again="Ricomincia", done="Finito")
