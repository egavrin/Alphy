app("Устройство атома", lang="ru", preset="clean", palette="indigo", kind="Урок")
need atom = drawing("Схема атома гелия", 240, 240, [circle(120, 120, 94, "ink", stroke=true), circle(120, 26, 8, $/part == "Электроны" ? "accent" : "ink"), circle(120, 214, 8, $/part == "Электроны" ? "accent" : "ink"), circle(110, 110, 14, $/part == "Ядро" ? "accent" : "warning"), circle(130, 110, 14, $/part == "Ядро" ? "accent" : "warning"), circle(110, 130, 14, $/part == "Ядро" ? "accent" : "surface"), circle(130, 130, 14, $/part == "Ядро" ? "accent" : "surface"), text(110, 110, "+", "ink", 14), text(130, 110, "+", "ink", 14), text(110, 130, "н", "ink", 12), text(130, 130, "н", "ink", 12)])
need part = input("choice", "Выбери часть", "Ядро", options=["Ядро", "Электроны"])
need explanation = card($/part, $/part == "Ядро" ? "В ядре находятся положительно заряженные протоны и нейтральные нейтроны. Почти вся масса атома сосредоточена в ядре." : "Электроны имеют отрицательный заряд и находятся вокруг ядра. Круг на схеме условен: электроны не движутся по точным круговым орбитам.", icon="Spark")
need lesson = lesson([{title: "Ядро", text: "Число протонов определяет химический элемент. У гелия их два."}, {title: "Электроны", text: "В нейтральном атоме число электронов равно числу протонов. Электроны образуют вокруг ядра облако вероятности."}], next="Далее", back="Назад", stepText="Шаг")
need quiz = question("Какая частица имеет положительный заряд?", options=["Протон", "Нейтрон", "Электрон"], right="Протон", rightText="Верно!", wrongText="Попробуй ещё раз")
