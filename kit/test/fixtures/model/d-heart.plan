app("Как сердце качает кровь", lang="ru", preset="clean", palette="red", kind="Объяснение")
need flow = drawing("Путь крови", 300, 220, [rect(100, 85, 100, 50, "accent", 12), text(150, 110, "Сердце", "surface", 16), rect(15, 20, 90, 40, $/phase == "К лёгким" ? "water" : "surface", 8), text(60, 40, "Лёгкие", "ink", 14), rect(195, 160, 90, 40, $/phase == "К телу" ? "warning" : "surface", 8), text(240, 180, "Тело", "ink", 14), line(110, 85, 80, 60, "water", 4), polygon([80, 60, 92, 62, 85, 70], "water"), line(60, 60, 100, 105, "water", 2), polygon([100, 105, 89, 101, 95, 95], "water"), line(190, 135, 220, 160, "accent", 4), polygon([220, 160, 208, 158, 215, 150], "accent"), line(240, 160, 200, 115, "accent", 2), polygon([200, 115, 211, 119, 205, 125], "accent")])
need phase = input("choice", "Проследить путь", "К лёгким", options=["К лёгким", "К телу"])
need detail = card("Два круга кровообращения", $/phase == "К лёгким" ? "Правая половина сердца отправляет кровь в лёгкие, где она насыщается кислородом. Затем кровь возвращается в левую половину сердца." : "Левая половина сердца отправляет богатую кислородом кровь к органам. Отдав кислород, кровь возвращается в правую половину сердца.", icon="Heart")
need lesson = lesson([{title: "Насос", text: "Сердце расслабляется и наполняется кровью, а затем сокращается и выталкивает её."}, {title: "Лёгкие", text: "Правая половина направляет кровь в лёгкие за кислородом."}, {title: "Всё тело", text: "Левая половина посылает кровь к органам; клапаны помогают ей течь в нужном направлении."}], next="Далее", back="Назад", stepText="Шаг")
need quiz = question("Куда правая половина сердца отправляет кровь?", options=["В лёгкие", "Сразу ко всем органам"], right="В лёгкие", rightText="Верно", wrongText="Попробуйте ещё раз")
