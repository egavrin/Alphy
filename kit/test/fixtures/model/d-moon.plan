app("Луна и Земля", lang="ru", preset="clean", palette="indigo", kind="Объяснение")
need orbit = drawing("Орбита Луны", 300, 300, [circle(150, 150, 95, "ink", stroke=true), circle(150, 150, 24, "water"), circle(150 + 95 * cos($/angle), 150 - 95 * sin($/angle), 15, "sand"), circle(150 + 84 * cos($/angle), 150 - 84 * sin($/angle), 4, "accent"), text(150, 270, "Точка обращена к Земле", "ink", 13)])
need angle = input("number", "Положение Луны на орбите", 0, min=0, max=360, step=30, icon="Repeat")
need explanation = card("Приливный захват", "Притяжение Земли постепенно замедлило вращение Луны. Теперь Луна делает один оборот вокруг своей оси за один оборот вокруг Земли, поэтому к нам обращена почти одна и та же её сторона.", icon="Globe")
need lesson = lesson([{title: "Движение по орбите", text: "Меняйте положение Луны: она движется вокруг Земли."}, {title: "Вращение Луны", text: "За один оборот по орбите Луна также один раз поворачивается вокруг своей оси. Цветная точка остаётся направленной к Земле."}, {title: "Почти одна сторона", text: "Из-за небольших колебаний видимая область немного меняется: это называется либрацией."}], next="Далее", back="Назад", stepText="Шаг")
need quiz = question("Сколько оборотов вокруг своей оси делает Луна за один оборот вокруг Земли?", options=["Один", "Ни одного", "Два"], right="Один", rightText="Верно", wrongText="Попробуйте ещё раз")
