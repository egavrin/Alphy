app("Как возникает радуга", lang="ru", preset="soft", palette="blue", kind="Объяснение")
need scheme = drawing("Путь света в капле воды", 240, 220, [circle(150, 105, 55, "water", stroke=true), line(15, 30, 111, 66, "sun", 4), line(111, 66, 203, 119, "sun", 3), line(203, 119, 130, 156, "sun", 3, visible=$/stage != "Преломление"), line(130, 156, 25, 176, "#E34A4A", 3, visible=$/stage == "Разложение"), line(130, 156, 25, 186, "#F29D38", 3, visible=$/stage == "Разложение"), line(130, 156, 25, 196, "#58A85C", 3, visible=$/stage == "Разложение"), line(130, 156, 25, 206, "#7754B5", 3, visible=$/stage == "Разложение"), text(48, 17, "Свет Солнца", "ink", 12), text(150, 105, "Капля", "ink", 12)])
need stage = input("choice", "Этап", "Преломление", options=["Преломление", "Отражение", "Разложение"])
need explanation = card("Свет и капля", "Солнечный свет преломляется при входе в каплю, отражается внутри и снова преломляется при выходе. Разные цвета отклоняются по-разному, поэтому наблюдатель видит радугу.", icon="Sun")
need lesson = lesson([{title: "Вход в каплю", text: "Белый солнечный свет меняет направление при переходе из воздуха в воду."}, {title: "Отражение", text: "Свет отражается от внутренней поверхности капли."}, {title: "Выход и цвета", text: "При выходе свет снова преломляется, а цвета расходятся. Радуга видна, когда Солнце находится позади наблюдателя, а капли дождя — впереди."}], next="Далее", back="Назад", stepText="Шаг")
need question = question("Почему в радуге видны разные цвета?", options=["Цвета отклоняются по-разному", "Капли окрашивают свет"], right="Цвета отклоняются по-разному", rightText="Верно!", wrongText="Свет уже содержит разные цвета.")
