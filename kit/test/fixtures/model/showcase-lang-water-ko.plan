app("하루 물 기록", lang="ko", preset="soft", palette="blue", kind="물 마시기")
need water = figure("number", "마신 물", $/cups, example=[{cups: 500}, 500], icon="💧", unit="ml", goal=2000, goalText="하루 목표 2,000ml")
need cups = counter("물 마시기", 0, step=250, min=0, addText="물 한 컵 마시기", icon="Glass", resetText="오늘 기록 초기화")
