app("Conta do churrasco", lang="pt", preset="soft", palette="orange", kind="Divisor de conta")
need pessoas = entries("Pessoas", fields={nome: "text", pago: "money"}, rows=[], labels={nome: "Nome", pago: "Quanto pagou"}, show={parte: count($/pessoas) > 0 ? sum($/pessoas, $pago) / count($/pessoas) : 0, deve: count($/pessoas) > 0 ? max(0, sum($/pessoas, $pago) / count($/pessoas) - $pago) : 0, recebe: count($/pessoas) > 0 ? max(0, $pago - sum($/pessoas, $pago) / count($/pessoas)) : 0}, icon="🍖", icons={nome: "Person", pago: "Wallet"}, addText="Adicionar pessoa", emptyText="Adicione as pessoas e quanto cada uma pagou", countText="Pessoas")
