scene("Как очки улучшают зрение", lang="ru", palette="blue")
control = choice("Очки", ["Без очков", "В очках"])
s1 = line(250, 35, 250, 185, "ink", 4)
s2 = text(250, 205, "Сетчатка", "ink", 14)
s3 = line(20, 65, 90, 65, "accent", 2)
s4 = line(20, 155, 90, 155, "accent", 2)
s5 = line(90, 65, $/v == "Без очков" ? 190 : 250, 110, "accent", 2)
s6 = line(90, 155, $/v == "Без очков" ? 190 : 250, 110, "accent", 2)
s7 = line(190, 110, 250, 137, "accent", 2, visible=$/v == "Без очков")
s8 = line(190, 110, 250, 83, "accent", 2, visible=$/v == "Без очков")
s9 = line(90, 45, 90, 175, "ink", 3, visible=$/v == "В очках")
s10 = text(90, 25, "Линза", "ink", 14, visible=$/v == "В очках")
caption = (($/v == "Без очков") ? "Лучи от далёкого предмета сходятся перед сетчаткой. Изображение на ней получается размытым." : "Рассеивающая линза сдвигает фокус на сетчатку. Далёкий предмет становится чётче.")
