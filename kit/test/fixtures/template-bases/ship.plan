scene("Корабль и гвоздь", lang="ru", palette="blue")
control = choice("Предмет", ["Корабль", "Гвоздь"])
s1 = rect(0, 100, 300, 120, "water", 0)
s2 = polygon([45, 80, 255, 80, 225, 125, 75, 125], "ink", visible=$/v == "Корабль")
s3 = rect(105, 55, 70, 25, "surface", 0, visible=$/v == "Корабль")
s4 = line(145, 174, 155, 200, "ink", 5, visible=$/v == "Гвоздь")
s5 = line(140, 176, 150, 172, "ink", 4, visible=$/v == "Гвоздь")
s6 = text(150, 25, $/v == "Корабль" ? "Большой объём" : "Малый объём", "ink", 16)
card = card("Почему так?", $/v == "Корабль" ? "Полый корабль вытесняет много воды. Её выталкивающая сила удерживает его на плаву." : "Гвоздь вытесняет мало воды. Её выталкивающая сила меньше веса гвоздя, и он тонет.")
