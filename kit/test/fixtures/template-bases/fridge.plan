scene("Как холодильник охлаждает", lang="ru", palette="blue")
control = choice("Этап", ["Испарение", "Сжатие", "Конденсация", "Расширение"])
s1 = rect(20, 35, 120, 50, $/v == "Испарение" ? "accent" : "surface", 8)
s2 = text(80, 60, "Испаритель", "ink", 14)
s3 = rect(160, 35, 120, 50, $/v == "Сжатие" ? "accent" : "surface", 8)
s4 = text(220, 60, "Компрессор", "ink", 14)
s5 = rect(160, 135, 120, 50, $/v == "Конденсация" ? "accent" : "surface", 8)
s6 = text(220, 160, "Конденсатор", "ink", 14)
s7 = rect(20, 135, 120, 50, $/v == "Расширение" ? "accent" : "surface", 8)
s8 = text(80, 160, "Клапан", "ink", 14)
s9 = text(150, 60, "→", "ink", 18)
s10 = text(220, 110, "↓", "ink", 18)
s11 = text(150, 160, "←", "ink", 18)
s12 = text(80, 110, "↑", "ink", 18)
card = card("Тепло уходит наружу", $/v == "Испарение" ? "Хладагент испаряется и забирает тепло из камеры." : $/v == "Сжатие" ? "Компрессор сжимает пар хладагента, и тот нагревается." : $/v == "Конденсация" ? "Хладагент отдаёт тепло комнате и превращается в жидкость." : "В клапане давление падает, хладагент охлаждается и цикл повторяется.")
