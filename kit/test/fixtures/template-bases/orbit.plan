scene("Земля вокруг Солнца", lang="ru", palette="indigo")
control = slider("Месяц", 0, 12, 1, 3)
s1 = circle(150, 150, 110, "ink", stroke=true)
s2 = use("sun", 150, 150, 70)
s3 = use("earth", 150 + 110 * cos($/v * 30), 150 - 110 * sin($/v * 30), 36)
s4 = text(150, 290, "Месяц " + text($/v) + " из 12", "ink", 14)
card = card("Год — один круг", "Земля обходит Солнце за 12 месяцев и за год возвращается на то же место.")
say = "Двигай месяц и смотри, где Земля на своём круге."
