scene("Что такое число π", lang="ru", palette="blue")
control = slider("Радиус", 40, 75, 5, 60)
s1 = circle(150, 110, $/v, "accent", stroke=true)
s2 = line(150 - $/v, 110, 150 + $/v, 110, "ink", 3)
s3 = text(150, 20, "Длина окружности", "ink", 14)
s4 = text(150, 200, "Линия — диаметр", "ink", 14)
card = card("Откуда берётся π", "π — отношение длины любой окружности к её диаметру. Это число всегда примерно равно 3,14159.")
