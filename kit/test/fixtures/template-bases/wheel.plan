scene("Колесо катится", lang="ru", palette="teal")
control = slider("Путь", 0, 200, 10, 60)
s1 = rect(0, 230, 300, 70, "land", 0, gradient="land-1")
s2 = circle(50 + $/v, 190, 40, "graphite")
s3 = circle(50 + $/v, 190, 30, "surface")
s4 = line(50 + $/v, 190, 50 + $/v + 30 * cos(-$/v * 1.43), 190 - 30 * sin(-$/v * 1.43), "accent", 4)
s5 = circle(50 + $/v, 190, 5, "ink")
caption = "За один оборот колесо проходит путь, равный длине своего обода."
say = "Двигай путь и следи за красной спицей: она поворачивается вместе с колесом."
