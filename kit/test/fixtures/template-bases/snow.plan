scene("Снег высоко в горах", lang="ru", palette="blue")
control = slider("Высота, м", 0, 4000, 500, 3000)
s1 = polygon([20, 190, 150, 40, 280, 190], "land")
s2 = polygon([124, 70, 150, 40, 176, 70, 163, 65, 150, 74, 137, 65], "surface")
